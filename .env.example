RAG_DATA_DIR=./data
RAG_DATABASE_PATH=./data/rag.db
RAG_MAX_UPLOAD_MB=50
RAG_CHUNK_TARGET_CHARS=3000
RAG_CHUNK_OVERLAP_CHARS=450
RAG_MAX_SEARCH_ROUNDS=4
RAG_MAX_TOOL_CALLS=12
RAG_RUN_TIMEOUT_SECONDS=120

# Runtime: demo (no credentials), gemini, or unsloth.
RAG_AGENT_PROVIDER=demo
RAG_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Unsloth exposes an OpenAI-compatible /v1 service. The app discovers entries
# marked loaded=true before every run. This optional ID is only a preference
# when multiple chat models are loaded; it never forces an unloaded model.
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_API_KEY=
UNSLOTH_MODEL_ID=

# Embeddings: deterministic is for demo/tests; gemini/openai are real paths.
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_DIMENSION=256
RAG_OPENAI_EMBEDDING_BASE_URL=
RAG_OPENAI_EMBEDDING_API_KEY=
